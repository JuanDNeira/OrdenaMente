{
  "expo": {
    "name": "OrdenaMente",
    "slug": "OrdenaMente",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ordenamente.app",
      "infoPlist": {
        "NSCameraUsageDescription": "OrdenaMente usa la cámara para reconocer objetos y sugerir nombre, categoría y acción ecológica.",
        "NSPhotoLibraryUsageDescription": "OrdenaMente accede a tu galería para agregar fotos a los ítems.",
        "NSBluetoothAlwaysUsageDescription": "OrdenaMente usa Bluetooth para detectar beacons BLE asociados a tus contenedores.",
        "NSBluetoothPeripheralUsageDescription": "OrdenaMente usa Bluetooth para detectar beacons BLE asociados a tus contenedores.",
        "NSLocationWhenInUseUsageDescription": "OrdenaMente necesita acceso a la ubicación para detectar beacons BLE cercanos (requisito de Android/iOS para BLE).",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OrdenaMente necesita acceso a la ubicación para detectar beacons BLE cercanos."
      }
    },
    "android": {
      "package": "com.ordenamente.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#1F9D6B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    
"plugins": [
  [
    "expo-build-properties",
    {
      "android": {
        "compileSdkVersion": 36,
        "targetSdkVersion": 36,
        "minSdkVersion": 24,
        "buildToolsVersion": "36.0.0"
      },
      "ios": {
        "deploymentTarget": "15.1"
      }
    }
  ],
  "expo-secure-store",
  "expo-sqlite",
  "expo-font",
  [
    "expo-splash-screen",
    {
      "image": "./assets/splash-icon.png",
      "imageWidth": 220,
      "backgroundColor": "#0A0A0F"
    }
  ]
],
    "extra": {
      "eas": {
        "projectId": "6e8db59f-a1c9-47b4-86cb-3d5bbe641ef9"
      }
    },
    "owner": "juandavidneira"
  }
}